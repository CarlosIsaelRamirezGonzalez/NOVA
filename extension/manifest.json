{
  "manifest_version": 3,
  "name": "Nova",
  "version": "0.23.0",
  "description": "Nova en el panel lateral de Chrome: platica contigo y usa tu navegador cuando se lo pides.",
  "minimum_chrome_version": "116",
  "permissions": [
    "sidePanel",
    "tabs",
    "scripting"
  ],
  "host_permissions": [
    "<all_urls>"
  ],
  "background": {
    "service_worker": "background.js"
  },
  "side_panel": {
    "default_path": "index.html"
  },
  "action": {
    "default_title": "Abrir a Nova",
    "default_icon": {
      "16": "icons/nova-16.png",
      "32": "icons/nova-32.png"
    }
  },
  "content_security_policy": {
    "extension_pages": "script-src 'self' 'wasm-unsafe-eval'; object-src 'self'"
  },
  "icons": {
    "16": "icons/nova-16.png",
    "32": "icons/nova-32.png",
    "48": "icons/nova-48.png",
    "128": "icons/nova-128.png"
  }
}
